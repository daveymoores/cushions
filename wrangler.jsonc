{
  // Cloudflare Workers deployment config for the Sisu storefront.
  // Unofficial (Hydrogen targets Oxygen) — paired with the cache shim in
  // app/lib/context.ts. The PUBLIC_* values are client-public and safe to
  // commit; SESSION_SECRET is set separately as a secret (see README/HANDOFF).
  "name": "sisu",
  "account_id": "bc84abad431336eff149920646572ce3",
  "main": "dist/server/index.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client"
  },
  "vars": {
    "PUBLIC_STORE_DOMAIN": "sisu-yswysm5o.myshopify.com",
    "PUBLIC_STOREFRONT_API_TOKEN": "cdab067bd5eba284adce4cb6b38c2e2c",
    "PUBLIC_STOREFRONT_ID": "4d6fec10-b67c-483f-8ab0-5c469758ab03",
    "PUBLIC_CHECKOUT_DOMAIN": "sisu-yswysm5o.myshopify.com"
  }
}
