# Copy to .env (which is gitignored) before running `npm run dev`.

# Required: signs the session cookie. Use a long random string in production.
SESSION_SECRET="local-dev-please-replace"

# Mock-data phase: the Hydrogen request handler still constructs a storefront
# client even when no loader queries it, so we point it at mock.shop. Replace
# all five values once a real Shopify store is connected.
PUBLIC_STORE_DOMAIN="mock.shop"
PUBLIC_STOREFRONT_API_TOKEN="mock-token"
PUBLIC_STOREFRONT_ID="mock-id"
PUBLIC_CHECKOUT_DOMAIN="mock.shop"

# PostHog analytics (EU cloud region). Optional: leave PUBLIC_POSTHOG_KEY empty
# and PostHog never initialises, so local dev sends no events.
PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
PUBLIC_POSTHOG_KEY=""
